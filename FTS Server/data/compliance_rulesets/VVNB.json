    { "rule_id": "VVNB-SEP-NOATS-001", "airport": "VVNB", "runway_mode": null, "operation_context": "AIRCRAFT_SEPARATION", "kind": "pairwise_min_distance",
      "conditions": { "surveillance": "none", "note": "Without ATS surveillance: departure clearance requires >=3 minutes before the landing aircraft's ETA (>=4 minutes specifically for a LIGHT departure behind a HEAVY arrival). Time-based, not distance-based -- no evaluator registered for this exact metric on this kind yet; kept for documentation, expect NOT_EVALUATED." },
      "threshold": { "metric": "timeToEtaSec", "operator": ">=", "value": 180, "unit": "s" },
      "severity": "VIOLATION", "source_document": "CHC song song VVNB 599.pdf", "source_section": "3.3.1(a), 3.3.2(c), 3.3.3(a) (without ATS surveillance, general case)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVNB-SEP-NOATS-LIGHT-AFTER-HEAVY-001", "airport": "VVNB", "runway_mode": null, "operation_context": "AIRCRAFT_SEPARATION", "kind": "pairwise_min_distance",
      "conditions": { "surveillance": "none", "leadCategory": "HEAVY", "trailCategory": "LIGHT",
        "note": "Special case: a LIGHT-category departure behind a HEAVY-category arrival requires 4 minutes (not the general 3 minutes) before the arrival's ETA when there is no ATS surveillance." },
      "threshold": { "metric": "timeToEtaSec", "operator": ">=", "value": 240, "unit": "s" },
      "severity": "VIOLATION", "source_document": "CHC song song VVNB 599.pdf", "source_section": "3.3.1(a), 3.3.2(c), 3.3.3(a) (LIGHT departure behind HEAVY arrival, without ATS surveillance)", "effective_date": "2026-08-12", "version": "2.0.0" },

