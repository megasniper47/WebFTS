    { "rule_id": "VVNB-INTDEP-001", "airport": "VVNB", "runway_mode": null, "operation_context": "INTERSECTION_DEPARTURE", "kind": "intersection_departure_distance",
      "conditions": { "intersections": ["11R/S3", "29L/S8", "29R/P8"] },
      "threshold": { "metric": "intersectionDepartureDistanceNm", "operator": ">=", "value": 3.0, "unit": "NM" },
      "severity": "VIOLATION", "source_document": "CHC song song VVNB 599.pdf", "source_section": "3.3.1(b), 3.3.2 (S8/29L clause), 3.3.3 (P8/29R clause)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVNB-GOAROUND-001", "airport": "VVNB", "runway_mode": null, "operation_context": "RUNWAY_OCCUPANCY", "kind": "occupancy_duration",
      "conditions": { "eventPair": "touchdown_to_go_around_decision",
