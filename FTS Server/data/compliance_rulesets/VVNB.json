      "threshold": { "metric": "departureRollStartDelaySec", "operator": "<=", "value": 30, "unit": "s" },
      "severity": "WARNING", "source_document": "CHC song song VVNB 599.pdf", "source_section": "3.4.2(b)", "effective_date": "2026-08-12", "version": "2.0.0" },

