      "severity": "WARNING", "source_document": "CHC song song VVNB 599.pdf", "source_section": "3.3.1(a), 3.3.2(c), 3.3.3(a) (Che do 1-4)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVNB-ROT-001", "airport": "VVNB", "runway_mode": null, "operation_context": "RUNWAY_OCCUPANCY", "kind": "occupancy_duration",
      "conditions": { "eventPair": "touchdown_to_vacate" },
      "threshold": { "metric": "runwayOccupancyTimeSec", "operator": "<=", "value": 60, "unit": "s" },
      "severity": "WARNING", "source_document": "CHC song song VVNB 599.pdf", "source_section": "3.4.2(c) (vacate within 60s of crossing the threshold to fully clearing the exit taxiway hold-short line)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVNB-DEPSTART-001", "airport": "VVNB", "runway_mode": null, "operation_context": "RUNWAY_OCCUPANCY", "kind": "occupancy_duration",
      "conditions": { "eventPair": "line_up_to_departure_roll_start",
