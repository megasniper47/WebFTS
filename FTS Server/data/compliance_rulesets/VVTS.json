    { "rule_id": "VVTS-CROSS-001", "airport": "VVTS", "runway_mode": null, "operation_context": "RUNWAY_CROSSING_WITH_ARRIVAL", "kind": "crossing_clearance_time",
      "conditions": {}, "threshold": { "metric": "crossingDurationSec", "operator": "<=", "value": 45, "unit": "s" },
      "severity": "VIOLATION", "source_document": "CHC Song song VVTS.pdf", "source_section": "3.5.2 (runway-crossing clearance must be completed within 45s of entering the runway)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVTS-CROSS-GNSS-DEGRADED-001", "airport": "VVTS", "runway_mode": null, "operation_context": "RUNWAY_CROSSING_WITH_ARRIVAL", "kind": "crossing_clearance_time",
      "conditions": { "scenario": "GNSS signal integrity degraded, RWY07 in use", "surveillance": "radar" }, "threshold": { "metric": "arrivalDistanceAtCrossingNm", "operator": ">=", "value": 4.0, "unit": "NM" },
      "severity": "VIOLATION", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.2.1.3(a) (with radar surveillance)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVTS-CROSS-GNSS-DEGRADED-002", "airport": "VVTS", "runway_mode": null, "operation_context": "RUNWAY_CROSSING_WITH_ARRIVAL", "kind": "crossing_clearance_time",
      "conditions": { "scenario": "GNSS signal integrity degraded, RWY07 in use", "surveillance": "none" }, "threshold": { "metric": "timeToThresholdSec", "operator": ">=", "value": 180, "unit": "s" },
      "severity": "VIOLATION", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.2.1.3(a) (without radar surveillance)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVTS-ROT-001", "airport": "VVTS", "runway_mode": null, "operation_context": "RUNWAY_OCCUPANCY", "kind": "occupancy_duration",
      "conditions": { "eventPair": "touchdown_to_vacate" },
      "threshold": { "metric": "runwayOccupancyTimeSec", "operator": "<=", "value": 60, "unit": "s" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "3.5.2 (vacate within 60s of crossing the threshold to fully clearing the exit taxiway hold-short line)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVTS-GOAROUND-001", "airport": "VVTS", "runway_mode": null, "operation_context": "RUNWAY_OCCUPANCY", "kind": "occupancy_duration",
      "conditions": { "eventPair": "touchdown_to_go_around_decision",
        "note": "If the landing aircraft goes around, the departure's takeoff clearance on the adjacent runway must be cancelled within 20s of the landing aircraft's touchdown-zone contact." },
      "threshold": { "metric": "goAroundClearanceCancelDelaySec", "operator": "<=", "value": 20, "unit": "s" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.2.1.1(c), 4.2.1.2(c), 4.2.1.3(b)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVTS-LINEUP-WEATHER-001", "airport": "VVTS", "runway_mode": null, "operation_context": "LINE_UP_WITH_ARRIVAL", "kind": "line_up_arrival_distance",
      "conditions": { "weatherConditional": true, "tier": "primary", "requiresVisibilityM": 1200, "requiresCeilingM": 130, "requiresPsrSsrStable": true, "requiresAtmDisplay10NM": true,
        "note": "Primary tier: hold-and-wait onto the runway regardless of the arrival's position is allowed only with VIS>=1200m, ceiling>=130m, stable PSR/SSR, ATM display set to observe the last 10NM of final. Currently NOT_EVALUATED: weather/PSR-SSR-status data not captured in replay_track.jsonl." },
      "threshold": { "metric": "holdAndWaitAllowed", "operator": "==", "value": true, "unit": "bool" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.1(a)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVTS-LINEUP-WEATHER-002", "airport": "VVTS", "runway_mode": null, "operation_context": "LINE_UP_WITH_ARRIVAL", "kind": "line_up_arrival_distance",
      "conditions": { "weatherConditional": true, "tier": "secondary", "visibilityRangeM": [1200, 3000], "ceilingRangeM": [130, 180], "requiresSmrStable": true, "requiresAtmDisplay2NM": true,
        "note": "Secondary tier (VIS 1200-3000m or ceiling 130-180m): requires stable SMR with ATM display set to observe the last 2NM of final, plus TWR crew support for trajectory judgement. Currently NOT_EVALUATED." },
      "threshold": { "metric": "holdAndWaitAllowed", "operator": "==", "value": true, "unit": "bool" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.1(a)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVTS-LINEUP-FALLBACK-001", "airport": "VVTS", "runway_mode": null, "operation_context": "LINE_UP_WITH_ARRIVAL", "kind": "line_up_arrival_distance",
      "conditions": { "note": "When neither weather/surveillance tier is met, a waiting departure may only enter the runway once the other runway's arrival has landed normally, and the NEXT arrival is at/beyond this distance (radar) or time (no radar) before roll starts." },
      "threshold": { "metric": "arrivalDistanceAtClearanceNm", "operator": ">=", "value": 6.0, "unit": "NM" },
      "severity": "VIOLATION", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.1(c) (with radar surveillance; 3 min before ETA without radar surveillance)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVTS-APPSPEED-001", "airport": "VVTS", "runway_mode": null, "operation_context": "REDUCED_SEPARATION", "kind": "approach_speed_schedule",
      "conditions": { "distanceFromThresholdNm": 25, "note": "No evaluator registered for kind 'approach_speed_schedule' yet -- honestly NOT_EVALUATED." },
      "threshold": { "metric": "approachSpeedKt", "operator": "between", "value": [190, 200], "unit": "kt" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "3.5.2 (at 25 track-miles from threshold)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVTS-APPSPEED-002", "airport": "VVTS", "runway_mode": null, "operation_context": "REDUCED_SEPARATION", "kind": "approach_speed_schedule",
      "conditions": { "phase": "established_on_final", "note": "No evaluator registered for kind 'approach_speed_schedule' yet -- honestly NOT_EVALUATED." },
      "threshold": { "metric": "approachSpeedKt", "operator": "between", "value": [160, 180], "unit": "kt" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "3.5.2 (established on final approach)", "effective_date": "2026-08-12", "version": "2.0.0" },
    { "rule_id": "VVTS-APPSPEED-003", "airport": "VVTS", "runway_mode": null, "operation_context": "REDUCED_SEPARATION", "kind": "approach_speed_schedule",
      "conditions": { "distanceFromThresholdNm": 5, "note": "No evaluator registered for kind 'approach_speed_schedule' yet -- honestly NOT_EVALUATED." },
      "threshold": { "metric": "approachSpeedKt", "operator": "between", "value": [150, 160], "unit": "kt" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "3.5.2 (at 5NM from threshold)", "effective_date": "2026-08-12", "version": "2.0.0" },

    { "rule_id": "VVTS-REDSEP-CHECKLIST-001", "airport": "VVTS", "runway_mode": null, "operation_context": "REDUCED_SEPARATION", "kind": "reduced_separation_checklist",
      "conditions": {
        "checklistItems": [
          "Trong khoang thoi gian 07:00-17:00 (gio dia phuong)",
          "Tieu chuan phan cach nhieu dong toi thieu van duoc ap dung",
          "Tam nhin toi thieu 5 km va tran may khong thap hon 1.000 ft",
          "Gio xuoi khong qua 5 kts",
          "Khong co dieu kien gio be mat bat loi (gio xuoi lon, gio dut, nhieu dong)",
          "Be mat duong CHC kho, hoat dong cua phanh tau bay khong bi anh huong",
          "Phan cach toi thieu tiep tuc ton tai giua 2 tau bay khoi hanh ngay sau khi tau bay thu hai cat canh",
          "Thong tin ve hoat dong bay truoc phai duoc KSVKL cung cap cho tau bay theo sau",
          "Ap dung dia tieu >=2400m de xac dinh cu ly; chi ap dung cho 01 duong CHC; to lai tau bay sau chiu trach nhiem phan cach voi tau bay truoc"
        ],
        "note": "All 9 conditions must hold simultaneously for the reduced-separation-in-the-aerodrome-area program to apply. No evaluator registered for kind 'reduced_separation_checklist' yet (requires weather/wind/runway-surface data not captured) -- honestly NOT_EVALUATED. This corrects an earlier, vague '8-point checklist' placeholder."
      },
      "threshold": { "metric": "allChecklistConditionsMet", "operator": "==", "value": true, "unit": "bool" },
      "severity": "WARNING", "source_document": "CHC Song song VVTS.pdf", "source_section": "4.2.2(a)", "effective_date": "2026-08-12", "version": "2.0.0" }
  ]
}
