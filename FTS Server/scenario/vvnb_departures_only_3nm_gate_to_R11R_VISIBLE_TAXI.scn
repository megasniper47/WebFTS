# WEBFTS_SCENARIO_ID vvnb_departures_only_3nm_gate_to_R11R_VISIBLE_TAXI
# WEBFTS_SCENARIO airport=VVNB type=DEPARTURE_ONLY movements=26 separationNm=3 arrRunway=NONE depRunway=11R surfaceSeparation="DEPARTURE_LINEUP_11R_MIN90S;PUSHBACK_ZONE_MIN70S" taxiMode="TIMED_GRAPH_POLYLINE_WITH_PUSHBACK"
# Description: aircraft push back from gate, taxi by DEP 1B/DEP 2B to holding point RWY 11R, line up, then take off RWY 11R.
# This .scn is self-contained for WebFTS embedded taxi animation. BlueSky/WebFTS basic aircraft motion is enabled: aircraft start at low taxi speed and follow ADDWPT ground route. WEBFTS_TAXI_COORDS remains embedded for enhanced pushback/taxi animation.
# WEBFTS_FIX_NOTE This version changes BlueSky command speed from 0 to visible taxi speed so departures move even if WebFTS ignores WEBFTS_TAXI_COORDS comments.
# WEBFTS_FIX_NOTE Pushback/taxi phases are still available in WEBFTS_TAXI_COORDS for the enhanced animator.
# WEBFTS_TAXI_FLIGHTS_BEGIN
